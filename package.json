{
  "name": "tradernet-sdk",
  "version": "0.1.0",
  "description": "Node.js / TypeScript SDK for the Tradernet public API V3: signed HTTP commands, SID session management and realtime WebSocket streams.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Tradernet API Support",
    "email": "kostikov@tradernet.com",
    "url": "https://tradernet.com"
  },
  "keywords": [
    "tradernet",
    "freedom-finance",
    "trading",
    "broker",
    "api",
    "sdk",
    "websocket"
  ],
  "homepage": "https://tradernet.com/tradernet-api/",
  "bugs": {
    "url": "https://tradernet.com/tradernet-api/"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "start": "node main.js",
    "example:quotes": "node examples/quotes.js",
    "example:portfolio": "node examples/portfolio.js",
    "example:orders": "node examples/orders.js",
    "example:ws": "node examples/websocket_quotes.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "ws": "^8.21.3"
  }
}
