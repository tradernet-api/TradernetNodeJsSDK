# Copy to .env and fill in values. Never commit .env.
# cp .env.example .env

TRADERNET_API_KEY=
TRADERNET_API_SECRET=

# Optional — needed for SID / account WebSocket streams
TRADERNET_LOGIN=
TRADERNET_PASSWORD=

# Optional
TRADERNET_DOMAIN=https://tradernet.com
TRADERNET_AUTH_MODE=sid_lazy
TRADERNET_LANG=en
# TRADERNET_SESSION_PATH=
# TRADERNET_SID_COOKIE=SID

# Examples: set to 1 for real account WebSocket (requires login/password)
# TRADERNET_WS_SID=0
